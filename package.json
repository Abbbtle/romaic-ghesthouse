{
  "name": "romaic-guesthouse-site",
  "version": "0.1.0",
  "private": true,
  "description": "Romaic Guesthouse: website, bookings and business dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --conditions=react-server --import ./scripts/test-static-assets.mjs --test \"src/**/*.test.ts\"",
    "test:postgres": "node -e \"process.env.TEST_DATABASE_URL || (console.error('Set TEST_DATABASE_URL to a direct Postgres connection string, e.g. postgres://localhost:5432/romaic_test'), process.exit(1))\" && tsx --conditions=react-server --import ./scripts/test-static-assets.mjs --test \"src/**/*.pg.test.ts\"",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "admin:reset-password": "tsx --conditions=react-server scripts/reset-password.ts",
    "check:workspace": "node scripts/check-workspace.mjs"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@gsap/react": "2.1.2",
    "@vercel/functions": "3.9.11",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lucide-react": "1.52.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "server-only": "^0.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
