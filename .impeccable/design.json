  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action in a view: navy with white text.",
      "html": "<button class=\"ds-btn-primary\">Save changes</button>",
      "css": ".ds-btn-primary{font-family:var(--font-sans,Arimo,Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 18px;border:1.5px solid transparent;border-radius:var(--radius-sm,2px);font-size:16px;font-weight:700;line-height:1.2;cursor:pointer;transition:color 150ms,background-color 150ms,border-color 150ms;background:var(--color-primary,#111d29);color:#fff;}.ds-btn-primary:hover{background:var(--color-primary-hover,#1e2f40);}.ds-btn-primary:active{background:var(--color-primary-active,#0b131b);transform:scale(.98);}.ds-btn-primary:focus-visible{outline:2px solid var(--color-focus,#111d29);outline-offset:2px;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Second action beside a primary: white, ink border.",
      "html": "<button class=\"ds-btn-secondary\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z\"/></svg><span>Call +27 76 957 9928</span></button>",
      "css": ".ds-btn-secondary{font-family:var(--font-sans,Arimo,Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 18px;border:1.5px solid transparent;border-radius:var(--radius-sm,2px);font-size:16px;font-weight:700;line-height:1.2;cursor:pointer;transition:color 150ms,background-color 150ms,border-color 150ms;background:#fff;color:var(--color-ink-black,#151316);border-color:var(--color-ink-black,#151316);}.ds-btn-secondary svg{width:20px;height:20px;}.ds-btn-secondary:hover{background:var(--color-neutral-25,#faf8f3);}.ds-btn-secondary:active{background:var(--color-neutral-50,#f3f0e8);}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-focus,#111d29);outline-offset:2px;}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Reads as a link: unpadded, underlined at rest, Gold Text on hover.",
      "html": "<button class=\"ds-btn-ghost\">Open in Google Maps</button>",
      "css": ".ds-btn-ghost{font-family:var(--font-sans,Arimo,Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 18px;border:1.5px solid transparent;border-radius:var(--radius-sm,2px);font-size:16px;font-weight:700;line-height:1.2;cursor:pointer;transition:color 150ms,background-color 150ms,border-color 150ms;padding:0;background:transparent;color:var(--color-link,#111d29);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px;}.ds-btn-ghost:hover{color:var(--color-link-hover,#74561c);text-decoration-thickness:2px;}.ds-btn-ghost:focus-visible{outline:2px solid var(--color-focus,#111d29);outline-offset:2px;}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Comfortable 48 px public field: white, control border, 2 px corners.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field__label\">Your name</span><input class=\"ds-field__input\" placeholder=\"Full name\"></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:var(--font-sans,Arimo,Arial,sans-serif);max-width:320px;}.ds-field__label{font-size:14px;font-weight:600;color:var(--color-ink-black,#151316);}.ds-field__input{height:48px;padding:0 12px;border:1px solid var(--color-control,#77705f);border-radius:var(--radius-field,2px);background:#fff;color:var(--color-ink-black,#151316);font:inherit;font-size:16px;transition:border-color 150ms;}.ds-field__input::placeholder{color:var(--color-neutral-600,#5c5649);}.ds-field__input:hover{border-color:var(--color-neutral-800,#2f2c26);}.ds-field__input:focus-visible{border-color:var(--color-focus,#111d29);outline:2px solid var(--color-focus,#111d29);outline-offset:2px;}"
    },
    {
      "name": "Gold-bar Heading",
      "kind": "custom",
      "refersTo": "gold-bar-heading",
      "description": "The page's one headline in the 100° gold gradient band, bold Arimo in ink.",
      "html": "<h2 class=\"ds-gold-bar\">Spacious apartments in Welkom</h2>",
      "css": ".ds-gold-bar{margin:0;padding:.7em 1.1em .6em;background-image:var(--gradient-gold,linear-gradient(100deg,#aa823a 0%,#e3ce74 38%,#cba959 62%,#aa823a 100%));color:#151316;font-family:var(--font-sans,Arimo,Arial,sans-serif);font-weight:700;font-size:clamp(1.625rem,1.25rem + 1.6vw,2.5rem);line-height:1.15;letter-spacing:-0.005em;box-shadow:inset 0 1px 0 rgb(255 255 255/.35),inset 0 -1px 0 rgb(21 19 22/.12);}"
    },
    {
      "name": "Marble Amenity Panel",
      "kind": "card",
      "refersTo": "marble-panel",
      "description": "Flat Marble White behind text, 4 px gold border, gold dividers and Gold Text line icons.",
      "html": "<div class=\"ds-marble\"><div class=\"ds-marble__row\"><svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12.55a11 11 0 0 1 14.08 0\"/><path d=\"M1.42 9a16 16 0 0 1 21.16 0\"/><path d=\"M8.53 16.11a6 6 0 0 1 6.95 0\"/><path d=\"M12 20h.01\"/></svg><div class=\"ds-marble__text\"><h3>Connectivity and water</h3><p>Fast, always-on Wi-Fi</p></div></div></div>",
      "css": ".ds-marble{background:var(--color-marble,#eef1f7);border:4px solid var(--color-romaic-gold,#cba959);padding:24px;box-shadow:var(--shadow-2,0 6px 16px -4px rgb(21 19 22/.07),0 2px 4px rgb(21 19 22/.04));font-family:var(--font-sans,Arimo,Arial,sans-serif);}.ds-marble__row{display:grid;grid-template-columns:3rem 1fr;gap:20px;align-items:start;color:var(--color-gold-text,#74561c);}.ds-marble__text{border-left:1px solid var(--color-romaic-gold,#cba959);padding-left:20px;}.ds-marble__text h3{margin:0 0 6px;font-family:var(--font-display,'Josefin Sans',sans-serif);font-weight:600;font-size:18px;letter-spacing:.14em;text-transform:uppercase;color:#151316;}.ds-marble__text p{margin:0;color:var(--color-neutral-700,#4a453b);}"
    },
    {
      "name": "Contact Bar",
      "kind": "custom",
      "refersTo": "contact-bar",
      "description": "Navy band with a 2 px gold top edge closing every public page: gold label, white bold links, gold icons.",
      "html": "<section class=\"ds-contact\"><p class=\"ds-contact__label\">WhatsApp or call to book</p><a class=\"ds-contact__link\" href=\"#\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z\"/></svg><span>Call +27 76 957 9928</span></a></section>",
      "css": ".ds-contact{background:var(--color-midnight-navy,#111d29);border-top:2px solid var(--color-romaic-gold,#cba959);padding:24px 16px;display:grid;gap:12px;font-family:var(--font-sans,Arimo,Arial,sans-serif);}.ds-contact__label{margin:0;font-family:var(--font-display,'Josefin Sans',sans-serif);font-size:14px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--color-romaic-gold,#cba959);}.ds-contact__link{display:inline-flex;align-items:center;gap:12px;min-height:44px;color:#fff;font-weight:700;text-decoration:none;text-underline-offset:4px;}.ds-contact__link svg{color:var(--color-romaic-gold,#cba959);}.ds-contact__link:hover{text-decoration:underline;}.ds-contact__link:focus-visible{outline:2px solid var(--color-champagne,#e3ce74);outline-offset:2px;}"
    },
    {
      "name": "Phone Booking Dock",
      "kind": "custom",
      "refersTo": "booking-dock",
      "description": "Two equal actions on navy, shown only after the hero's booking buttons scroll away; hidden from 1024 px.",
      "html": "<nav class=\"ds-dock\" aria-label=\"Book your stay\"><a href=\"#\" class=\"ds-dock__btn\">Call</a><a href=\"#\" class=\"ds-dock__btn ds-dock__btn--primary\">WhatsApp</a></nav>",
      "css": ".ds-dock{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:8px 12px;background:var(--color-midnight-navy,#111d29);border-top:2px solid var(--color-romaic-gold,#cba959);box-shadow:var(--shadow-sheet,0 -12px 32px rgb(17 29 41/.075));font-family:var(--font-sans,Arimo,Arial,sans-serif);}.ds-dock__btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;border-radius:2px;border:1.5px solid rgb(236 232 221/.7);color:#fff;font-size:14px;font-weight:700;letter-spacing:.025em;text-decoration:none;}.ds-dock__btn:hover{background:rgb(255 255 255/.1);}.ds-dock__btn--primary{background:var(--color-cream,#ece8dd);border-color:transparent;color:var(--color-midnight-navy,#111d29);}.ds-dock__btn--primary:hover{background:#fff;}.ds-dock__btn:focus-visible{outline:2px solid var(--color-champagne,#e3ce74);outline-offset:2px;}"
    },
    {
      "name": "Dashboard Sidebar Nav",
      "kind": "nav",
      "refersTo": "admin-nav-current",
