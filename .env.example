# Copy to .env.local for development. On Vercel, set these under Project → Settings → Environment Variables.
# Nothing here is required to run the site on your machine: without DATABASE_URL it uses PGlite
# (Postgres inside the app) in ./data.nosync/pglite.

# --- Site -----------------------------------------------------------------------------------------
# The public address, used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=

# --- Dashboard host (recommended in production) ---------------------------------------------------
# Serve the dashboard from its own host, such as admin.example.co.za (threat model D1). With it set
# at build time, the public host answers 404 for /admin and the dashboard host serves only the
# dashboard. Leave empty to serve the dashboard under /admin on the site's own host.
ADMIN_HOST=

# --- Database (Supabase Postgres in production) ---------------------------------------------------
# The site's connection, as the limited runtime role romaic_app (create it with LOGIN and a strong
# password before migrating; migrations grant it what it needs, minus edits to append-only tables).
# Use the transaction pooler (port 6543). The Vercel ↔ Supabase integration sets POSTGRES_URL instead.
DATABASE_URL=
# The migration connection, as the tables' owner, direct or session pooler (port 5432), for
# `npm run db:migrate` and `npm run admin:reset-password`. The integration sets POSTGRES_URL_NON_POOLING.
DATABASE_URL_UNPOOLED=
# Connections per server instance. Keep this small on serverless.
DATABASE_POOL_MAX=3
# The database server's root certificate (PEM), if your host uses a private CA other than Supabase's.
DATABASE_CA_CERT=
# Where PGlite keeps the development database when DATABASE_URL isn't set.
PGLITE_DATA_DIR=./data.nosync/pglite

# --- Encryption at rest (required in production) --------------------------------------------------
# Keys for values encrypted in the database: authenticator secrets, channel calendar links and feed
# tokens, bank account numbers, tax reference numbers and employees' tax numbers. Recovery codes are
# stored as HMACs under keys derived from these, so a copy of the database alone can't reveal them.
# "k1:" followed by 32 random bytes in base64. Make one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# To rotate, put the new key first ("k2:…,k1:…") and redeploy: new values use the new key, and every old
# value stays readable while the old key is still listed. The daily job (/api/cron/daily) re-seals
# authenticator secrets only ("storedSecrets"). KEEP THE OLD KEY LISTED: channel links, feed tokens,
# bank, tax and employee numbers aren't re-sealed yet (open question #84), so dropping it makes them
# unreadable, and recovery codes made under it stop working. Losing every key makes all of them
# unreadable for good.
# Audit log entries are signed with keys derived from these too, so an edit made with only the
# database shows up on the Activity page. An entry whose key is dropped no longer checks out, and
# the break-glass reset (npm run admin:reset-password) needs this set to exactly the site's.
DATA_ENCRYPTION_KEY=

# --- Dashboard (/admin) ---------------------------------------------------------------------------
# Asked for when creating the first owner. Required in production: any long random string.
ADMIN_SETUP_TOKEN=
# Visitors' IP addresses are hashed with this before they're used for rate limits, and it signs
# short tokens. Any long random string. Required on Vercel.
VISITOR_KEY_SECRET=
# The header your host puts the visitor's IP address in. Defaults to x-forwarded-for (last address),
# which is right on Vercel.
CLIENT_IP_HEADER=

# --- Email (https://resend.com; provider still to be approved) ------------------------------------
# Optional. Needed for owners' password-reset links and email confirmation. Without these, emails are
# printed to the terminal in development and not sent in production.
RESEND_API_KEY=
# A sender on a domain you've verified with the provider.
NOTIFY_FROM_EMAIL="Romaic Guesthouse <bookings@example.co.za>"

# --- Daily maintenance (Vercel Cron) --------------------------------------------------------------
# Vercel sends this as a bearer token to /api/cron/daily. Any long random string. Required in production.
CRON_SECRET=

# --- Payments ------------------------------------------------------------------------------------
# No real payment gateway is chosen yet. "test" turns on the test gateway, which never moves money;
# "none" turns it off. Development uses the test gateway unless this says none; production only with
# PAYMENT_GATEWAY=test and a TEST_GATEWAY_SECRET of at least 32 characters.
PAYMENT_GATEWAY=
# What the test gateway signs its webhooks with. Any random string of 32 characters or more.
TEST_GATEWAY_SECRET=

# --- Client design preview ------------------------------------------------------------------------
# Set to 1 (at build time) for a preview deployment while the pages are being built: the home page
# then redirects to the /kit design preview and search engines are told not to index the site.
DESIGN_PREVIEW=
